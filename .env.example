# Copie para .env.local e preencha. NUNCA versione valores reais.
# Para o Supabase local, os valores aparecem em `pnpm supabase status`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Indexação pelo Google. Desligada por padrão (robots.txt bloqueia tudo e as
# páginas levam noindex). Ligue só no lançamento: SITE_INDEXING=on
# SITE_INDEXING=

# Opcional: estilo do mapa (MapLibre). Padrão: OpenFreeMap "positron".
# NEXT_PUBLIC_MAP_STYLE_URL=

# Somente servidor. Ignora as políticas RLS: nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-robô do formulário de reserva). Obrigatório em
# produção. Para desenvolvimento, a Cloudflare publica chaves de teste:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Avisos por e-mail ao administrador (Resend). Sem a chave, ficam desativados.
# Até registrar um domínio, o Resend só envia do remetente de teste
# "onboarding@resend.dev" para o e-mail da própria conta (docs/contato.md).
# RESEND_API_KEY=
# EMAIL_FROM=Alugue Houses <onboarding@resend.dev>
# ADMIN_NOTIFY_EMAIL=contatoaluguehouses@gmail.com

# Vídeos enviados pelo painel (opcionais; padrões abaixo). O tamanho também
# é limitado no bucket "property-videos" do Supabase: para subir o limite,
# mude os dois (docs/videos.md). O plano gratuito aceita até 50 MB por arquivo.
# VIDEO_MAX_UPLOAD_MB=50
# VIDEO_MAX_PER_PROPERTY=6

# Somente desenvolvimento e testes: caixa de e-mail local do Supabase (Mailpit).
# Também recebe os avisos do site quando não há RESEND_API_KEY.
# NUNCA configure em produção.
MAILPIT_URL=http://127.0.0.1:54324
